[Unit]
Description=Bounded spotifyd incident recorder
After=network.target
StartLimitIntervalSec=300
StartLimitBurst=3

[Service]
Type=simple
ExecStart=/usr/bin/python3 /usr/local/lib/spotifyd-diagnostics/recorder.py
Restart=on-failure
RestartSec=15
UMask=0077
Nice=10
IOSchedulingClass=idle
MemoryMax=192M
TasksMax=32
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=read-only
StateDirectory=spotifyd-diagnostics
StateDirectoryMode=0700
ReadWritePaths=/var/lib/spotifyd-diagnostics
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
