{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/transition-feature-snapshot-v3.schema.json",
  "title": "transition-feature-snapshot/3",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "snapshot_sha256", "analysis", "pair", "outgoing", "incoming"],
  "properties": {
    "schema_version": {"const": "transition-feature-snapshot/3"},
    "snapshot_sha256": {"$ref": "#/$defs/hash"},
    "analysis": {"$ref": "#/$defs/analysis"},
    "pair": {"$ref": "#/$defs/pair"},
    "outgoing": {"$ref": "#/$defs/source"},
    "incoming": {"$ref": "#/$defs/source"}
  },
  "$defs": {
    "hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "ppm": {"type": "integer", "minimum": 0, "maximum": 1000000},
    "frame": {"type": "integer", "minimum": 0, "maximum": 9007199254740991},
    "relative_frame": {"type": "integer", "minimum": -705600, "maximum": 264600},
    "analysis": {
      "type": "object", "additionalProperties": false,
      "required": ["analysis_id", "extractor_id", "extractor_version", "algorithm_sha256", "analysis_sha256"],
      "properties": {
        "analysis_id": {"type": "string", "pattern": "^analysis2-[0-9a-f]{64}$"},
        "extractor_id": {"type": "string", "minLength": 1},
        "extractor_version": {"type": "string", "minLength": 1},
        "algorithm_sha256": {"$ref": "#/$defs/hash"},
        "analysis_sha256": {"$ref": "#/$defs/hash"}
      }
    },
    "cue": {
      "type": "object", "additionalProperties": false,
      "required": ["cue_id", "source_frame", "kind", "confidence_ppm"],
      "properties": {
        "cue_id": {"type": "string", "pattern": "^cue1-[0-9a-f]{64}$"},
        "source_frame": {"$ref": "#/$defs/frame"},
        "kind": {"enum": ["intro", "outro"]},
        "confidence_ppm": {"$ref": "#/$defs/ppm"}
      }
    },
    "rhythm": {
      "type": "object", "additionalProperties": false,
      "required": ["beat_frames", "downbeat_frames", "tempo_millibpm", "beat_confidence_ppm", "downbeat_confidence_ppm"],
      "properties": {
        "beat_frames": {"type": "array", "minItems": 2, "items": {"$ref": "#/$defs/frame"}},
        "downbeat_frames": {"type": "array", "items": {"$ref": "#/$defs/frame"}},
        "meter_beats": {"type": "integer", "minimum": 2, "maximum": 12},
        "tempo_millibpm": {"type": "integer", "minimum": 20000, "maximum": 400000},
        "beat_confidence_ppm": {"$ref": "#/$defs/ppm"},
        "downbeat_confidence_ppm": {"$ref": "#/$defs/ppm"}
      }
    },
    "window": {
      "type": "object", "additionalProperties": false,
      "required": ["window_id", "kind", "start_frame", "end_frame"],
      "properties": {
        "window_id": {"type": "string", "pattern": "^window1-[0-9a-f]{64}$"},
        "kind": {"enum": ["outgoing_transition", "incoming_transition"]},
        "start_frame": {"$ref": "#/$defs/frame"}, "end_frame": {"$ref": "#/$defs/frame"},
        "vocal_activity_ppm": {"$ref": "#/$defs/ppm"},
        "transient_activity_ppm": {"$ref": "#/$defs/ppm"}, "transient_density_ppm": {"$ref": "#/$defs/ppm"},
        "hard_cut_safe": {"type": "boolean"}, "bass_occupancy_ppm": {"$ref": "#/$defs/ppm"},
        "spectral_stability_ppm": {"$ref": "#/$defs/ppm"}, "low_occupancy_ppm": {"$ref": "#/$defs/ppm"},
        "mid_occupancy_ppm": {"$ref": "#/$defs/ppm"}, "high_occupancy_ppm": {"$ref": "#/$defs/ppm"},
        "short_term_loudness_mlu": {"type": "integer", "minimum": -120000, "maximum": 24000},
        "energy_variability_mdb": {"type": "integer", "minimum": 0, "maximum": 120000}
      }
    },
    "source": {
      "type": "object", "additionalProperties": false,
      "required": ["source_pcm_sha256", "source_frames", "cues", "windows", "sample_peak_mdbfs", "true_peak_mdbtp"],
      "properties": {
        "source_pcm_sha256": {"$ref": "#/$defs/hash"}, "source_frames": {"type": "integer", "minimum": 1, "maximum": 9007199254740991},
        "cues": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/cue"}}, "rhythm": {"$ref": "#/$defs/rhythm"},
        "windows": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/window"}},
        "sample_peak_mdbfs": {"type": "integer", "minimum": -120000, "maximum": 12000},
        "true_peak_mdbtp": {"type": "integer", "minimum": -120000, "maximum": 12000}
      }
    },
    "pair": {
      "type": "object", "additionalProperties": false,
      "required": ["outgoing_cue_id", "incoming_cue_id", "outgoing_window_id", "incoming_window_id"],
      "properties": {
        "outgoing_cue_id": {"type": "string", "pattern": "^cue1-[0-9a-f]{64}$"},
        "incoming_cue_id": {"type": "string", "pattern": "^cue1-[0-9a-f]{64}$"},
        "outgoing_window_id": {"type": "string", "pattern": "^window1-[0-9a-f]{64}$"},
        "incoming_window_id": {"type": "string", "pattern": "^window1-[0-9a-f]{64}$"},
        "vocal_collision_ppm": {"$ref": "#/$defs/ppm"}, "vocal_collision_span_frames": {"type": "integer", "minimum": 1},
        "vocal_collision_start_frame": {"$ref": "#/$defs/relative_frame"}, "vocal_collision_end_frame": {"$ref": "#/$defs/relative_frame"},
        "outgoing_vocal_collision_strength_ppm": {"$ref": "#/$defs/ppm"}, "incoming_vocal_collision_strength_ppm": {"$ref": "#/$defs/ppm"},
        "transient_collision_ppm": {"$ref": "#/$defs/ppm"}, "transient_collision_span_frames": {"type": "integer", "minimum": 1},
        "transient_collision_start_frame": {"$ref": "#/$defs/relative_frame"}, "transient_collision_end_frame": {"$ref": "#/$defs/relative_frame"},
        "outgoing_transient_collision_strength_ppm": {"$ref": "#/$defs/ppm"}, "incoming_transient_collision_strength_ppm": {"$ref": "#/$defs/ppm"},
        "bass_collision_ppm": {"$ref": "#/$defs/ppm"}, "spectral_overlap_ppm": {"$ref": "#/$defs/ppm"},
        "energy_delta_mdb": {"type": "integer", "minimum": -120000, "maximum": 120000},
        "alignment_error_ppm_of_beat": {"$ref": "#/$defs/ppm"}
      }
    }
  }
}
